<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the engine-free core tests without Unity (dotnet run, from this folder). Uses a tiny NUnit shim; Unity uses real NUnit. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Shim.cs" />
    <Compile Include="../../Assets/Scripts/Core/**/*.cs" />
    <!-- engine-free tests only: MenkTests, PuppetTests, SnowPrintsTests, PaletteTests and YardLayoutTests need UnityEngine -->
    <Compile Include="../../Assets/Tests/EditMode/**/*.cs" Exclude="../../Assets/Tests/EditMode/MenkTests.cs;../../Assets/Tests/EditMode/PuppetTests.cs;../../Assets/Tests/EditMode/SnowPrintsTests.cs;../../Assets/Tests/EditMode/PaletteTests.cs;../../Assets/Tests/EditMode/YardLayoutTests.cs" />
    <None Include="../../Assets/Data/World/*" LinkBase="Assets/Data/World" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The Elbrus location is optional, the way the Steam layer is: dotnet run -p:NoElbrus=true builds the game
       without it and proves the core still compiles and passes on its own. Unity does the same thing with the
       defineConstraints "!HEIGHT1079_NO_ELBRUS" on Height1079.Elbrus.Core and Height1079.Elbrus.Tests. -->
  <ItemGroup Condition="'$(NoElbrus)' == 'true'">
    <Compile Remove="../../Assets/Scripts/Core/Elbrus/**/*.cs" />
    <Compile Remove="../../Assets/Tests/EditMode/Elbrus/**/*.cs" />
  </ItemGroup>
  <PropertyGroup Condition="'$(NoElbrus)' == 'true'">
    <DefineConstants>$(DefineConstants);HEIGHT1079_NO_ELBRUS</DefineConstants>
  </PropertyGroup>
</Project>
